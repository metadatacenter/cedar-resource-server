<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.metadatacenter</groupId>
    <artifactId>cedar-resource-server</artifactId>
    <version>2.9.9-SNAPSHOT</version>
  </parent>

  <artifactId>cedar-resource-server-application</artifactId>
  <packaging>jar</packaging>

  <name>CEDAR Resource Server Dropwizard Application</name>

  <properties>
    <!-- Opt in to the cedar-shade execution managed in cedar-parent. -->
    <cedar.shade.phase>package</cedar.shade.phase>
    <cedar.shade.main.class>org.metadatacenter.cedar.resource.ResourceServerApplication</cedar.shade.main.class>
  </properties>

  <dependencies>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-rest-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-globals-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-cache-operations-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-queue-operations-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-config-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-utils-core-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-utils-dropwizard-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-resource-server-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-auth-operations-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-user-operations-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-workspace-operations-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-search-operations-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-logging-operations-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-inclusion-subgraph-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-valuerecommender-operations-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-artifact-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
    </dependency>

    <dependency>
      <groupId>io.dropwizard</groupId>
      <artifactId>dropwizard-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi</artifactId>
    </dependency>

    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi-private</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.dropwizard</groupId>
      <artifactId>dropwizard-testing</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- In-process Neo4j and graph seeding for integration tests -->
    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-test-support-library</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Direct declaration required: the server stack transitively pins JNA 4.2.1 (no arm64
      slice), and only a direct dependency wins Maven's mediation for the test classpath. The
      version must match the one cedar-test-support-library declares.
    -->
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-model-validation-library</artifactId>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.module</groupId>
      <artifactId>jackson-module-afterburner</artifactId>
    </dependency>

    <dependency>
      <groupId>me.xdrop</groupId>
      <artifactId>fuzzywuzzy</artifactId>
    </dependency>

    <!-- Swagger v3 annotations (@Operation, @Tag, @ApiResponse, ...) used to generate the OpenAPI 3.0 spec at build time -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
    </dependency>

  </dependencies>

  <build>

    <plugins>

      <!--
        The tests redirect the CEDAR environment variables (embedded Neo4j, alternate server
        ports) through a CedarEnvironmentSource override instead of reflective environment
        rewriting, so no add-opens flags are needed and the test classes share a JVM
        (reuseForks true): CedarConfig.getInstance rebuilds whenever the override changes.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <reuseForks>true</reuseForks>
        </configuration>
      </plugin>

      <!--
        Filters the base OpenAPI document (src/main/swagger/openapi-base.yaml) so ${project.version}
        is stamped into info.version, then writes it to target/. The swagger-maven-plugin reads the
        filtered copy to seed the generated spec's info block and the api_key security scheme.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>filter-openapi-base</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/generated-swagger</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/main/swagger</directory>
                  <includes>
                    <include>openapi-base.yaml</include>
                  </includes>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Generates the OpenAPI 3.0 spec from the JAX-RS (jakarta.ws.rs) resource annotations.

        Output goes to src/main/resources/assets/swagger-api/ as swagger.json + swagger.yaml (the
        committed location). The generated files are tracked in git (visible/diffable/recoverable),
        and Maven copies them onto the classpath (target/classes -> runnable jar), which is what the
        Dropwizard AssetsBundle serves. The execution is bound to prepare-package, so any build that
        reaches package/install (e.g. `mvn clean install`, cedarcli build all) regenerates the
        committed spec in place; commit the result like any tracked generated artifact.

        The official io.swagger.core.v3 plugin (jakarta line) resolves the mojo with the project's
        compile+runtime classpath, so resource classes that extend cedar-* library base classes load
        and their annotations are introspected. sortOutput keeps the emitted maps key-sorted so the
        committed spec is byte-stable across builds. The info block and the api_key security scheme
        come from the filtered openapi-base.yaml.
      -->
      <plugin>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-maven-plugin-jakarta</artifactId>
        <configuration>
          <outputPath>${project.basedir}/src/main/resources/assets/swagger-api</outputPath>
          <outputFileName>swagger</outputFileName>
          <outputFormat>JSONANDYAML</outputFormat>
          <prettyPrint>true</prettyPrint>
          <sortOutput>true</sortOutput>
          <resourcePackages>
            <package>org.metadatacenter.cedar.resource.resources</package>
          </resourcePackages>
          <openapiFilePath>${project.build.directory}/generated-swagger/openapi-base.yaml</openapiFilePath>
        </configuration>
        <executions>
          <execution>
            <phase>prepare-package</phase>
            <goals>
              <goal>resolve</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>

    </plugins>

  </build>

  <profiles>
    <profile>
      <id>opensearch-it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <cedar.test.suppressAppLogQueue>true</cedar.test.suppressAppLogQueue>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
